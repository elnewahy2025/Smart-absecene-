# Production environment template.
#
# Copy this file to .env.production and fill in the real values BEFORE running
# `npm run build`. Vite reads .env.production with higher priority than .env, so
# whatever is here is what gets baked into the shipped dist/ bundle.
#
# Never commit the real .env.production (it contains secrets). .gitignore ignores .env*.

# ---------------------------------------------------------------------------
# Server (never shipped to the browser)
# ---------------------------------------------------------------------------
PORT=5050
NODE_ENV=production
APP_URL=https://your-school-domain.example

# Firebase Admin credential — paste the BASE64 of the service-account JSON.
# Get it from the Firebase Console: Project settings > Service accounts >
# Generate new private key, then base64-encode the downloaded file.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=

# Master key for per-tenant AI secrets. Generate with:
#   node scripts/rotate-tenant-ai-secrets.mjs --generate
TENANT_ENCRYPTION_MASTER_KEY=

# Google Gemini key used as the platform default when a school has none.
GEMINI_API_KEY=

# Comma-separated emails allowed to act as platform owner (must be verified).
PLATFORM_OWNER_EMAILS=you@your-domain.example

# Fallback tenant when the hostname does not match a school.
DEFAULT_TENANT_ID=

# Dev auth must be OFF in production.
ALLOW_DEV_AUTH=false

# Set ONLY when the app runs behind a reverse proxy / load balancer (nginx,
# Cloudflare, an app platform). Leave unset for direct traffic.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Client (VITE_* — these ARE embedded in the bundle; they are public by design)
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
VITE_PLATFORM_OWNER_EMAIL=you@your-domain.example
VITE_PLATFORM_OWNER_EMAILS=you@your-domain.example
VITE_DEFAULT_TENANT_ID=
VITE_USE_FIREBASE_EMULATOR=false
