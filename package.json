{
  "name": "smart-school-attendance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"vite.config.ts.timestamp-*\" --exclude \".zwork/**\" --exclude \"dist/**\" server.ts",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-smart-school",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "dev:emulator": "node scripts/dev-emulator.mjs",
    "smoke:emulator": "node scripts/emulator-smoke.mjs",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=server.js",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rimraf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "seed:auth": "tsx scripts/seed-firebase-auth.ts",
    "seed:tenant": "node scripts/seed-tenant-demo.mjs",
    "probe:security": "node scripts/security-probes.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-smart-school \"node scripts/test-firestore-rules.mjs\"",
    "test:seats": "firebase emulators:exec --only firestore --project demo-smart-school \"tsx scripts/test-user-seats.ts && tsx scripts/test-student-seats.ts\"",
    "reconcile:seats": "tsx scripts/reconcile-user-seats.ts",
    "audit": "node scripts/ci-security-audit.mjs",
    "audit:users": "tsx scripts/audit-unprovisioned-users.ts",
    "rotate:secrets": "node scripts/rotate-tenant-ai-secrets.mjs",
    "migrate:secrets": "node scripts/migrate-ai-secrets-to-firestore.mjs",
    "migrate:gateway": "tsx scripts/migrate-gateway-secrets.ts",
    "golive": "node scripts/golive-check.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sparticuz/chromium": "^153.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.7.0",
    "helmet": "^7.2.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.294.0",
    "nodemailer": "^6.10.1",
    "puppeteer": "^25.13.0",
    "puppeteer-core": "^25.14.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.2",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "esbuild": "^0.19.11",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.6.1"
  }
}
