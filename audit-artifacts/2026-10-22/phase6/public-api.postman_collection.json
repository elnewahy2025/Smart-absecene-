{
  "info": {
    "name": "Smart School API contract (public boundary)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('json content type', () => pm.expect(pm.response.headers.get('content-type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('status ok', () => pm.expect(body.status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Public tenant projection",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/tenants" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('no-store', () => pm.expect(pm.response.headers.get('cache-control')).to.include('no-store'));",
              "const body = pm.response.json();",
              "pm.test('tenant array', () => pm.expect(body.tenants).to.be.an('array'));",
              "pm.test('no raw config fields', () => {",
              "  for (const t of body.tenants) {",
              "    pm.expect(t).to.not.have.property('aiConfig');",
              "    pm.expect(t).to.not.have.property('gateway');",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Tenant resolve",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tenant/resolve?tenant=school-1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('resolved or explicit non-resolved state', () => pm.expect(['resolved','unknown_domain','inactive_tenant']).to.include(body.status));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous students list is rejected",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/students" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous provisioning is rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/api/tenants/provision"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Public route bypass is case-insensitive",
      "request": { "method": "POST", "url": "{{baseUrl}}/API/PDF/GENERATE" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
