rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    /// Platform-owner verification. ONLY `admins/{uid}` documents with role
    /// `super_admin` bypass tenant isolation and subscription gating. A school
    /// admin lives in `users/{uid}` with role `admin` and stays tenant-scoped.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() <= 120 &&
             data.role == 'super_admin';
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'tenantId', 'name', 'email', 'role']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.tenantId is string && data.tenantId.size() <= 50 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email.size() <= 120 &&
             data.role in ['admin', 'registrar', 'teacher', 'parent'];
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['studentNumber', 'fullName', 'className', 'tenantId']) &&
             data.studentNumber is string && data.studentNumber.size() <= 30 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
             data.className is string && data.className.size() <= 30 &&
             data.tenantId is string && data.tenantId.size() <= 50 &&
             (!('nationalId' in data) || (data.nationalId is string && data.nationalId.size() <= 30)) &&
             (!('totalAbsences' in data) || data.totalAbsences is number) &&
             (!('attendanceRate' in data) || data.attendanceRate is number);
    }

    function isValidAttendanceSession(data) {
      return data.keys().hasAll(['tenantId', 'date', 'sessionType', 'className', 'status']) &&
             data.tenantId is string && data.tenantId.size() <= 50 &&
             data.date is string && data.date.size() <= 30 &&
             data.sessionType in ['daily', 'period'] &&
             data.className is string && data.className.size() <= 30 &&
             data.status in ['draft', 'submitted', 'reopened'] &&
             (!('totalStudents' in data) || data.totalStudents is number) &&
             (!('presentCount' in data) || data.presentCount is number);
    }

    function isValidJustification(data) {
      return data.keys().hasAll(['tenantId', 'studentId', 'absenceDate', 'reasonType', 'guardianExplanation', 'status']) &&
             data.tenantId is string && data.tenantId.size() <= 50 &&
             data.studentId is string && data.studentId.size() <= 128 &&
             data.absenceDate is string && data.absenceDate.size() <= 30 &&
             data.reasonType in ['medical', 'family', 'travel', 'other'] &&
             data.guardianExplanation is string && data.guardianExplanation.size() <= 1000 &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['tenantId', 'recipientPhone', 'messageText', 'channel', 'status']) &&
             data.tenantId is string && data.tenantId.size() <= 50 &&
             data.recipientPhone is string && data.recipientPhone.size() <= 30 &&
             data.messageText is string && data.messageText.size() <= 500 &&
             data.channel in ['SMS', 'WhatsApp'] &&
             data.status in ['pending', 'sent', 'failed'];
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['tenantId', 'entityType', 'action', 'performerName', 'details', 'timestamp']) &&
             data.tenantId is string && data.tenantId.size() <= 50 &&
             data.entityType is string && data.entityType.size() <= 50 &&
             data.action is string && data.action.size() <= 50 &&
             data.performerName is string && data.performerName.size() <= 120 &&
             data.details is string && data.details.size() <= 1000 &&
             data.timestamp is string && data.timestamp.size() <= 50;
    }

    // --- COLLECTION RULES ---

    // --- RBAC & MULTI-TENANT HELPERS ---
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Only staff-provisioned, active profiles get tenant access. Legacy
    // self-registered profiles never received a server-owned `status` field,
    // so this blocks them immediately even before they are cleaned up.
    function hasActiveUserDoc() {
      return hasUserDoc() && getUserData().get('status', '') == 'active';
    }

    function isTenantUser(tenantId) {
      return isSignedIn() && (isAdmin() || (hasActiveUserDoc() && getUserData().tenantId == tenantId && tenantAccessAllowed(tenantId)));
    }

    function isTenantRole(tenantId, roles) {
      return isSignedIn() && (isAdmin() || (hasActiveUserDoc() && getUserData().tenantId == tenantId && getUserData().role in roles && tenantAccessAllowed(tenantId)));
    }

    // --- SUBSCRIPTION / RENEWAL ENFORCEMENT (defense-in-depth) ---
    // Mirrors the server middleware. A tenant with no subscription document is
    // grandfathered as active. accessUntilMs is period end + grace in epoch ms
    // (0 = never expires), denormalized by the server so rules need no date math.
    function tenantSubscription(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('subscription', null);
    }

    function tenantAccessAllowed(tenantId) {
      return !exists(/databases/$(database)/documents/tenants/$(tenantId))
        || tenantSubscription(tenantId) == null
        || (
          tenantSubscription(tenantId).get('manuallySuspended', false) == false
          && tenantSubscription(tenantId).get('status', 'active') != 'suspended'
          && tenantSubscription(tenantId).get('status', 'active') != 'expired'
          && (
            tenantSubscription(tenantId).get('accessUntilMs', 0) == 0
            || request.time.toMillis() < tenantSubscription(tenantId).get('accessUntilMs', 0)
          )
        );
    }

    function isTeacherAssigned(data) {
      return isTenantRole(data.tenantId, ['admin', 'registrar']) ||
        (isTenantRole(data.tenantId, ['teacher']) && (
          ('teacherId' in data && data.teacherId == request.auth.uid) ||
          (('assignedClasses' in getUserData()) && 'classId' in data && data.classId in getUserData().assignedClasses)
        ));
    }

    // A parent may only file an excuse for a student who is actually their
    // child in the same tenant (phone or email on the student record).
    function isGuardianOfStudentInTenant(studentId, tenantId) {
      return exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/students/$(studentId)).data.tenantId == tenantId
        && (
          (get(/databases/$(database)/documents/students/$(studentId)).data.get('guardianPhone', '') != ''
            && get(/databases/$(database)/documents/students/$(studentId)).data.get('guardianPhone', '') == getUserData().get('phone', ''))
          || (get(/databases/$(database)/documents/students/$(studentId)).data.get('guardianEmail', '') != ''
            && get(/databases/$(database)/documents/students/$(studentId)).data.get('guardianEmail', '') == getUserData().get('email', ''))
        );
    }

    // --- COLLECTION RULES ---

    // 1. Admins Collection (Platform Super-Admins)
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming());
    }

    // 1b. Tenant registry (authenticated tenant members or platform admins only)
    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (isAdmin() || (hasActiveUserDoc() && getUserData().tenantId == tenantId));
      allow write: if isAdmin();
    }
    // 2. Users Collection (Profile & Role Management)
    // Reads are always tenant-scoped: a school admin/registrar can never list or
    // fetch staff from another school, even though the collection is global.
    match /users/{userId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == userId ||
        (hasActiveUserDoc() && getUserData().role in ['admin', 'registrar'] &&
          existing().tenantId == getUserData().tenantId &&
          tenantAccessAllowed(existing().tenantId))
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        (hasActiveUserDoc() && getUserData().role in ['admin', 'registrar'] &&
          resource.data.tenantId == getUserData().tenantId &&
          tenantAccessAllowed(resource.data.tenantId))
      );
      // Profile documents are provisioned server-side with the Admin SDK. The
      // client may only create one as the platform owner; self-registration
      // would let an account inject a trusted phone/email and unlock another
      // family's student records.
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) &&
                    isAdmin();
      // Profile update cannot elevate role, change tenant, or rewrite verified contact fields
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() || (
          tenantAccessAllowed(existing().tenantId) &&
          request.auth.uid == userId &&
          incoming().role == existing().role &&
          incoming().tenantId == existing().tenantId &&
          incoming().phone == existing().phone &&
          incoming().email == existing().email &&
          incoming().get('status', '') == existing().get('status', '') &&
          incoming().get('assignedClasses', []) == existing().get('assignedClasses', []) &&
          incoming().get('assignedSubjects', []) == existing().get('assignedSubjects', [])
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 3. Students Collection (Multi-Tenant & Role Isolation)
    match /students/{studentId} {
      // Staff can read all tenant students; parents can only read their child
      allow read: if isSignedIn() && (
        isAdmin() || (
          hasActiveUserDoc() && resource.data.tenantId == getUserData().tenantId && tenantAccessAllowed(resource.data.tenantId) && (
            getUserData().role in ['admin', 'registrar', 'teacher'] ||
            (getUserData().role == 'parent' && (
              (resource.data.get('guardianPhone', '') != '' && resource.data.get('guardianPhone', '') == getUserData().get('phone', '')) ||
              (resource.data.get('guardianEmail', '') != '' && resource.data.get('guardianEmail', '') == getUserData().get('email', '')) ||
              ('id' in resource.data && resource.data.id == request.auth.uid)
            ))
          )
        )
      );
      // Creation/deletion are server-only so the maxStudents counter cannot be
      // bypassed with a direct Firestore write. Lifecycle changes (transfer /
      // restore) also go through the API because they alter the seat count.
      allow create, delete: if false;
      // Admin and Registrar may still edit profile fields, but cannot move a
      // record between schools or change its enrollment status directly.
      allow update: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming()) &&
                    isTenantRole(resource.data.tenantId, ['admin', 'registrar']) &&
                    incoming().tenantId == resource.data.tenantId &&
                    incoming().get('enrollmentStatus', 'active') == resource.data.get('enrollmentStatus', 'active');
    }

    // 4. Attendance Sessions Collection
    match /attendance_sessions/{sessionId} {
      allow read: if isSignedIn() && (
        isAdmin() || (
          hasActiveUserDoc() && resource.data.tenantId == getUserData().tenantId && tenantAccessAllowed(resource.data.tenantId) &&
          getUserData().role in ['admin', 'registrar', 'teacher']
        )
      );
      // Create session: Admin, Registrar, or Teacher assigned to that class
      allow create: if isSignedIn() && isValidId(sessionId) && isValidAttendanceSession(incoming()) &&
                    isTeacherAssigned(incoming());
      // Update session:
      // If submitted: ONLY Admin or Registrar can reopen/edit!
      // If draft or reopened: Admin, Registrar, or assigned Teacher
      allow update: if isSignedIn() && isValidId(sessionId) && isValidAttendanceSession(incoming()) &&
                    isTenantUser(resource.data.tenantId) && (
                      isTenantRole(resource.data.tenantId, ['admin', 'registrar']) ||
                      (resource.data.status in ['draft', 'reopened'] && isTeacherAssigned(resource.data))
                    );
      allow delete: if isSignedIn() && isValidId(sessionId) && isTenantRole(resource.data.tenantId, ['admin']);
    }

    // 4b. Per-student attendance mirrors (parents see only their child)
    match /attendance_records/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin() || (
          hasActiveUserDoc() && resource.data.tenantId == getUserData().tenantId && tenantAccessAllowed(resource.data.tenantId) && (
            getUserData().role in ['admin', 'registrar', 'teacher'] ||
            (getUserData().role == 'parent' &&
              resource.data.get('guardianPhone', '') != '' &&
              resource.data.get('guardianPhone', '') == getUserData().get('phone', ''))
          )
        )
      );
      allow create: if isSignedIn() && isTeacherAssigned(request.resource.data);
      allow update: if isSignedIn() && isTeacherAssigned(resource.data) && isTeacherAssigned(request.resource.data);
      allow delete: if isSignedIn() && isTenantRole(resource.data.tenantId, ['admin']);
    }
    // 5. Justifications & Medical Excuses Collection
    match /justifications/{justificationId} {
      allow read: if isSignedIn() && (
        isAdmin() || (
          hasActiveUserDoc() && resource.data.tenantId == getUserData().tenantId && tenantAccessAllowed(resource.data.tenantId) && (
            getUserData().role in ['admin', 'registrar', 'teacher'] ||
            ('studentId' in resource.data && resource.data.studentId == request.auth.uid) ||
            (getUserData().role == 'parent' &&
              resource.data.get('guardianPhone', '') != '' &&
              resource.data.get('guardianPhone', '') == getUserData().get('phone', ''))
          )
        )
      );
      // Parents and teachers may only submit a pending excuse; approval is staff-only.
      // A parent must be the guardian of the referenced student in this tenant.
      allow create: if isSignedIn() && isValidId(justificationId) && isValidJustification(incoming()) &&
                    isTenantUser(incoming().tenantId) &&
                    (
                      isTenantRole(incoming().tenantId, ['admin', 'registrar']) ||
                      (incoming().status == 'pending' && (
                        isTenantRole(incoming().tenantId, ['teacher']) ||
                        (getUserData().role == 'parent' && isGuardianOfStudentInTenant(incoming().studentId, incoming().tenantId))
                      ))
                    );
      // Reviewing (status change to approved/rejected): ONLY Admin and Registrar!
      allow update: if isSignedIn() && isValidId(justificationId) && isValidJustification(incoming()) &&
                    isTenantRole(resource.data.tenantId, ['admin', 'registrar']);
      allow delete: if isSignedIn() && isValidId(justificationId) &&
                    isTenantRole(resource.data.tenantId, ['admin']);
    }

    // 6. School Settings Collection (tenant-readable, no credentials)
    match /settings/{tenantId} {
      allow read: if isTenantUser(tenantId);
      // Only School Admin can modify institutional settings
      allow write: if isTenantRole(tenantId, ['admin']);
    }

    // 6b. Private integration credentials (SMS / WhatsApp / SMTP) are stored
    // encrypted at rest and are only readable through the server API, which
    // checks the platform-owner role. No browser may touch this document.
    match /settings_private/{tenantId} {
      allow read, write: if false;
    }

    // 7. Notification Outbox Collection
    match /notification_outbox/{notificationId} {
      allow read: if isSignedIn() && (
        isTenantRole(resource.data.tenantId, ['admin', 'registrar']) ||
        (hasActiveUserDoc() && resource.data.tenantId == getUserData().tenantId && tenantAccessAllowed(resource.data.tenantId) && getUserData().role == 'parent' &&
          resource.data.get('recipientPhone', '') != '' && resource.data.get('recipientPhone', '') == getUserData().get('phone', ''))
      );
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) &&
                    isTenantRole(incoming().tenantId, ['admin', 'registrar', 'teacher']);
      allow update: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) &&
                    isTenantRole(resource.data.tenantId, ['admin', 'registrar']);
      allow delete: if isSignedIn() && isValidId(notificationId) &&
                    isTenantRole(resource.data.tenantId, ['admin']);
    }

    // 8. Audit Logs Collection (Append-Only & Multi-Tenant Scoped)
    match /audit_logs/{logId} {
      // Only Admin and Registrar can view audit logs
      allow read: if isSignedIn() && isTenantRole(resource.data.tenantId, ['admin', 'registrar']);
      // Audit entries may only be appended by school staff, never by parents
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming()) &&
                    isTenantRole(incoming().tenantId, ['admin', 'registrar', 'teacher']);
      // Modifications and deletions are strictly forbidden for tamper-evidence
      allow update, delete: if false;
    }
  }
}
