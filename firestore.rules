rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    /// Bootstrapped Admin verification using trusted admin doc ONLY
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() <= 120 &&
             data.role in ['admin', 'super_admin'];
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'tenantId', 'name', 'email', 'role']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.tenantId is string && data.tenantId.size() <= 50 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email.size() <= 120 &&
             data.role in ['admin', 'registrar', 'teacher', 'parent'];
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['studentNumber', 'fullName', 'className', 'tenantId']) &&
             data.studentNumber is string && data.studentNumber.size() <= 30 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
             data.className is string && data.className.size() <= 30 &&
             data.tenantId is string && data.tenantId.size() <= 50 &&
             (!('nationalId' in data) || (data.nationalId is string && data.nationalId.size() <= 30)) &&
             (!('totalAbsences' in data) || data.totalAbsences is number) &&
             (!('attendanceRate' in data) || data.attendanceRate is number);
    }

    function isValidAttendanceSession(data) {
      return data.keys().hasAll(['tenantId', 'date', 'sessionType', 'className', 'status']) &&
             data.tenantId is string && data.tenantId.size() <= 50 &&
             data.date is string && data.date.size() <= 30 &&
             data.sessionType in ['daily', 'period'] &&
             data.className is string && data.className.size() <= 30 &&
             data.status in ['draft', 'submitted', 'reopened'] &&
             (!('totalStudents' in data) || data.totalStudents is number) &&
             (!('presentCount' in data) || data.presentCount is number);
    }

    function isValidJustification(data) {
      return data.keys().hasAll(['tenantId', 'studentId', 'absenceDate', 'reasonType', 'guardianExplanation', 'status']) &&
             data.tenantId is string && data.tenantId.size() <= 50 &&
             data.studentId is string && data.studentId.size() <= 128 &&
             data.absenceDate is string && data.absenceDate.size() <= 30 &&
             data.reasonType in ['medical', 'family', 'travel', 'other'] &&
             data.guardianExplanation is string && data.guardianExplanation.size() <= 1000 &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['tenantId', 'recipientPhone', 'messageText', 'channel', 'status']) &&
             data.tenantId is string && data.tenantId.size() <= 50 &&
             data.recipientPhone is string && data.recipientPhone.size() <= 30 &&
             data.messageText is string && data.messageText.size() <= 500 &&
             data.channel in ['SMS', 'WhatsApp'] &&
             data.status in ['pending', 'sent', 'failed'];
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['tenantId', 'entityType', 'action', 'performerName', 'details', 'timestamp']) &&
             data.tenantId is string && data.tenantId.size() <= 50 &&
             data.entityType is string && data.entityType.size() <= 50 &&
             data.action is string && data.action.size() <= 50 &&
             data.performerName is string && data.performerName.size() <= 120 &&
             data.details is string && data.details.size() <= 1000 &&
             data.timestamp is string && data.timestamp.size() <= 50;
    }

    // --- COLLECTION RULES ---

    // --- RBAC & MULTI-TENANT HELPERS ---
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTenantUser(tenantId) {
      return isSignedIn() && (isAdmin() || (hasUserDoc() && getUserData().tenantId == tenantId));
    }

    function isTenantRole(tenantId, roles) {
      return isSignedIn() && (isAdmin() || (hasUserDoc() && getUserData().tenantId == tenantId && getUserData().role in roles));
    }

    function isTeacherAssigned(data) {
      return isTenantRole(data.tenantId, ['admin', 'registrar']) ||
        (isTenantRole(data.tenantId, ['teacher']) && (
          ('teacherId' in data && data.teacherId == request.auth.uid) ||
          (('assignedClasses' in getUserData()) && 'classId' in data && data.classId in getUserData().assignedClasses)
        ));
    }

    // --- COLLECTION RULES ---

    // 1. Admins Collection (Platform Super-Admins)
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming());
    }

    // 2. Users Collection (Profile & Role Management)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || (hasUserDoc() && getUserData().role in ['admin', 'registrar']));
      allow list: if isSignedIn() && (isAdmin() || (hasUserDoc() && getUserData().role in ['admin', 'registrar']));
      // New user registration cannot self-grant 'admin' role unless platform admin
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() || (
          request.auth.uid == userId &&
          incoming().role in ['teacher', 'parent', 'registrar']
        )
      );
      // Profile update cannot elevate role or change tenant unless platform admin
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() || (
          request.auth.uid == userId &&
          incoming().role == existing().role &&
          incoming().tenantId == existing().tenantId
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 3. Students Collection (Multi-Tenant & Role Isolation)
    match /students/{studentId} {
      // Staff can read all tenant students; parents can only read their child
      allow read: if isSignedIn() && (
        isAdmin() || (
          hasUserDoc() && resource.data.tenantId == getUserData().tenantId && (
            getUserData().role in ['admin', 'registrar', 'teacher'] ||
            (getUserData().role == 'parent' && (
              resource.data.guardianPhone == getUserData().phone ||
              resource.data.guardianEmail == getUserData().email ||
              resource.data.id == request.auth.uid
            ))
          )
        )
      );
      // Only Admin and Registrar can create or modify student master records
      allow create: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming()) &&
                    isTenantRole(incoming().tenantId, ['admin', 'registrar']);
      allow update: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming()) &&
                    isTenantRole(resource.data.tenantId, ['admin', 'registrar']);
      allow delete: if isAdmin() && isValidId(studentId);
    }

    // 4. Attendance Sessions Collection
    match /attendance_sessions/{sessionId} {
      allow read: if isSignedIn() && (
        isAdmin() || (
          hasUserDoc() && resource.data.tenantId == getUserData().tenantId && (
            getUserData().role in ['admin', 'registrar', 'teacher'] ||
            getUserData().role == 'parent'
          )
        )
      );
      // Create session: Admin, Registrar, or Teacher assigned to that class
      allow create: if isSignedIn() && isValidId(sessionId) && isValidAttendanceSession(incoming()) &&
                    isTeacherAssigned(incoming());
      // Update session:
      // If submitted: ONLY Admin or Registrar can reopen/edit!
      // If draft or reopened: Admin, Registrar, or assigned Teacher
      allow update: if isSignedIn() && isValidId(sessionId) && isValidAttendanceSession(incoming()) &&
                    isTenantUser(resource.data.tenantId) && (
                      isTenantRole(resource.data.tenantId, ['admin', 'registrar']) ||
                      (resource.data.status in ['draft', 'reopened'] && isTeacherAssigned(resource.data))
                    );
      allow delete: if isAdmin() && isValidId(sessionId);
    }

    // 5. Justifications & Medical Excuses Collection
    match /justifications/{justificationId} {
      allow read: if isSignedIn() && (
        isAdmin() || (
          hasUserDoc() && resource.data.tenantId == getUserData().tenantId && (
            getUserData().role in ['admin', 'registrar', 'teacher'] ||
            resource.data.studentId == request.auth.uid ||
            (getUserData().role == 'parent' && resource.data.studentId == request.auth.uid)
          )
        )
      );
      // Parent or staff can create a justification in their tenant
      allow create: if isSignedIn() && isValidId(justificationId) && isValidJustification(incoming()) &&
                    isTenantUser(incoming().tenantId);
      // Reviewing (status change to approved/rejected): ONLY Admin and Registrar!
      allow update: if isSignedIn() && isValidId(justificationId) && isValidJustification(incoming()) &&
                    isTenantRole(resource.data.tenantId, ['admin', 'registrar']);
      allow delete: if isAdmin() && isValidId(justificationId);
    }

    // 6. School Settings Collection
    match /settings/{tenantId} {
      allow read: if isTenantUser(tenantId);
      // Only School Admin can modify institutional settings
      allow write: if isTenantRole(tenantId, ['admin']);
    }

    // 7. Notification Outbox Collection
    match /notification_outbox/{notificationId} {
      allow read: if isSignedIn() && isTenantRole(resource.data.tenantId, ['admin', 'registrar']);
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) &&
                    isTenantRole(incoming().tenantId, ['admin', 'registrar', 'teacher']);
      allow update: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) &&
                    isTenantRole(resource.data.tenantId, ['admin', 'registrar']);
      allow delete: if isAdmin() && isValidId(notificationId);
    }

    // 8. Audit Logs Collection (Append-Only & Multi-Tenant Scoped)
    match /audit_logs/{logId} {
      // Only Admin and Registrar can view audit logs
      allow read: if isSignedIn() && isTenantRole(resource.data.tenantId, ['admin', 'registrar']);
      // Any authenticated tenant user can append audit entries
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming()) &&
                    isTenantUser(incoming().tenantId);
      // Modifications and deletions are strictly forbidden for tamper-evidence
      allow update, delete: if false;
    }
  }
}
