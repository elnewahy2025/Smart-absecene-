# Environment variables
# Copy this file to .env and fill in the real values per environment.

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
APP_AUTH_TOKEN=dev-token-change-me

GEMINI_API_KEY=your-gemini-key-here

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Production notes:
# - Keep all real secrets in a managed secret store or CI environment.
# - Do not commit real values to source control.
