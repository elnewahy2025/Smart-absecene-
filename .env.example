# Environment variables
# Copy this file to .env and fill in the real values per environment.

PORT=5050
NODE_ENV=development
APP_URL=http://localhost:5050
APP_AUTH_TOKEN=dev-token-change-me

GEMINI_API_KEY=your-gemini-key-here

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Firebase Admin SDK:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# FIREBASE_PROJECT_ID=your-project-id

# Production notes:
# - Keep all real secrets in a managed secret store or CI environment.
# - Do not commit real values to source control.

# Local development authentication (never enable in production)
ALLOW_DEV_AUTH=false
DEV_AUTH_ROLE=teacher
DEV_AUTH_TENANT=school-1
PLATFORM_OWNER_EMAILS=owner@smartschool.platform
# Chromium sandbox is mandatory; this project no longer reads PUPPETEER_NO_SANDBOX.
# Firebase web config extras (public identifiers, safe in the bundle)
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
VITE_FIREBASE_OAUTH_CLIENT_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Optional local dev credential used by the browser when no Firebase user exists.
# NEVER set this for a production build.
VITE_DEV_AUTH_TOKEN=

# Server-side Firebase Admin. Only needed to verify real ID tokens / use admin APIs.
# Preferred: base64 of the service-account JSON on a single line.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternative: a JSON file path.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your-project-id

# Per-tenant AI key encryption. Required; changing it invalidates tenant-ai-secrets.json.
TENANT_ENCRYPTION_MASTER_KEY=

# Optional overrides
# DYNAMIC_TENANTS_PATH=./src/config/dynamicTenants.json
# CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe
# PUPPETEER_EXECUTABLE_PATH=

# Reverse-proxy trust (M-2). Unset/false => X-Forwarded-* headers are ignored.
# Set to the number of trusted hops (e.g. 1) or a subnet list when behind a known proxy.
# TRUST_PROXY=1

VITE_PLATFORM_OWNER_EMAIL=owner@example.com
VITE_PLATFORM_OWNER_EMAILS=owner@example.com
SEED_DEFAULT_PASSWORD=change-me-before-seeding

DEFAULT_TENANT_ID=school-1
VITE_DEFAULT_TENANT_ID=school-1

VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_PROJECT_ID=demo-smart-school
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8099
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8099
EMULATOR_SEED_PASSWORD=change-me-before-seeding
